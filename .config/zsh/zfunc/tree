#
# Display a tree structure with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `bat` that preserves colors and line numbers.
#

if ! (($+commands[eza])); then
    echo "tree: eza is not installed" >&2
    return 1
fi

if (($+commands[bat])); then
    eza --all --tree --color always --ignore-glob '.git|node_modules' --group-directories-first "${@:-.}" | bat
else
    eza --all --tree --ignore-glob '.git|node_modules' --group-directories-first "${@:-.}"
fi
